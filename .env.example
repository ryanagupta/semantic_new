NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Better Auth account sessions. Use a separate random secret of at least 32 characters in production.
# Development creates a private, persistent secret in the data directory if omitted.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional social sign-in. Set both values and register /api/auth/callback/{provider}.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RELAY_DATABASE_PATH=./data/relay.db
GATEWAY_INTERNAL_URL=http://127.0.0.1:3001
DATABASE_PATH=./data/nexus.db
# Required in production. Use at least 24 characters; local development uses nexus-local-dev.
DASHBOARD_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 32-byte hex encryption key, required in production for stored upstream secrets.
ENCRYPTION_KEY=
# Optional Redis for shared atomic sliding-window limits. SQLite is single-instance storage.
REDIS_URL=
# Relay scraper builder. Disabled until the browser, guarded egress, OpenRouter and Redis are ready.
SCRAPER_ENABLED=false
SCRAPER_BROWSERLESS_URL=http://browserless:3000
SCRAPER_BROWSERLESS_TOKEN=
SCRAPER_EGRESS_PROXY_URL=http://egress:8080
SCRAPER_WORKER_CONCURRENCY=2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
# Compose deployment only; generate distinct random values and use a real DNS domain.
REDIS_PASSWORD=
BROWSERLESS_IMAGE=ghcr.io/browserless/chromium:latest
DOMAIN=relay.example.com
CERTBOT_EMAIL=
# Comma-separated exact upstream hostnames; blank permits public internet hosts.
UPSTREAM_ALLOWLIST=
UPSTREAM_TIMEOUT_MS=5000
MAX_RESPONSE_BYTES=5242880
# Optional external gateway JWT verification. Tokens need sub and scope claims.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
# Only set if a trusted proxy overwrites X-Forwarded-For and the gateway cannot be reached directly.
TRUST_PROXY_HOPS=0
# Dodo billing stays disabled until all credentials, catalog IDs and Redis are configured.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_BUSINESS_ID=
DODO_PRO_PRODUCT_ID=
DODO_CREDITS_PRODUCT_ID=
# Configure a fixed-price monthly Pro product and fixed-price one-time 10,000-credit product.
# Optional operator-owned Enterprise policy (no public Enterprise checkout).
ENTERPRISE_MONTHLY_CREDITS=10000000
ENTERPRISE_REQUESTS_PER_MINUTE=10000
ENTERPRISE_TOOLS_PER_MINUTE=2000
# Optional outbound webhook to your notification/email service; called once at 80% usage, retried on failure.
QUOTA_NOTIFICATION_WEBHOOK_URL=
QUOTA_NOTIFICATION_WEBHOOK_TOKEN=
# Registry providers have no invented endpoints. Set authorized public HTTPS services.
# Sequential Thinking's official server is stdio; supply your deployed HTTP adapter here.
REACTBITS_MCP_URL=
REACTBITS_MCP_TRANSPORT=sse
SEQUENTIAL_THINKING_MCP_URL=
SEQUENTIAL_THINKING_MCP_TRANSPORT=sse
MOBBIN_MCP_URL=
MOBBIN_MCP_TRANSPORT=streamable-http
MOBBIN_OAUTH_AUTHORIZATION_URL=
MOBBIN_OAUTH_TOKEN_URL=
MOBBIN_OAUTH_CLIENT_ID=
MOBBIN_OAUTH_CLIENT_SECRET=
MOBBIN_OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
MOBBIN_OAUTH_SCOPE=
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TRANSPORT=streamable-http
HIGGSFIELD_OAUTH_AUTHORIZATION_URL=
HIGGSFIELD_OAUTH_TOKEN_URL=
HIGGSFIELD_OAUTH_CLIENT_ID=
HIGGSFIELD_OAUTH_CLIENT_SECRET=
HIGGSFIELD_OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
HIGGSFIELD_OAUTH_SCOPE=

# Additional Better Auth social providers. Secrets remain server-side.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
PAYBIN_CLIENT_ID=
PAYBIN_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
RAILWAY_CLIENT_ID=
RAILWAY_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REGION=
COGNITO_USER_POOL_ID=
TIKTOK_CLIENT_KEY=
