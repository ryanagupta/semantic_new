{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "outDir": "dist", "rootDir": ".",
    "sourceMap": true, "declaration": true, "rewriteRelativeImportExtensions": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"], "exclude": ["node_modules"]
}
