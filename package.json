{
  "name": "relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,gateway \"next dev --hostname 127.0.0.1\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:gateway": "tsx watch server/index.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "concurrently -k -n web,gateway \"next start\" \"node dist/server/index.js\"",
    "start:gateway": "node dist/server/index.js",
    "mcp:stdio": "tsx server/stdio.ts",
    "enterprise:provision": "tsx scripts/provision-enterprise.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@radix-ui/react-slot": "^1.5.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-auth": "^1.7.11",
    "class-variance-authority": "^0.7.1",
    "dodopayments": "^2.55.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "isolated-vm": "^7.0.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "playwright-core": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "redis": "^5.9.0",
    "server-only": "^0.0.1",
    "standardwebhooks": "^1.1.1",
    "swagger-ui-react": "^5.34.0",
    "undici": "^7.16.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
